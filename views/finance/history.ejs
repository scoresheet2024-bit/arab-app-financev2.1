<%- include('../partials/header', { title: 'Payment History' }) %>
<%- include('../partials/navigation') %>

<style>
    .history-page { padding: 30px; background: #f7f9fc; min-height: calc(100vh - 68px); color: #172033; }
    .history-header { display:flex; justify-content:space-between; align-items:flex-start; gap:20px; margin-bottom:24px; }
    .history-page h1 { margin:0 0 8px; font-size:36px; }
    .history-subtitle { color:#667085; font-size:18px; }
    .history-card { background:white; border:1px solid #e1e5ec; border-radius:14px; padding:24px; margin-bottom:24px; box-shadow:0 2px 6px rgba(0,0,0,.04); }
    .history-filters { background:#f8fafc; border:1px solid #e1e5ec; border-radius:12px; padding:18px; }
    .filter-row { display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
    .filter { padding:11px 13px; border:1px solid #ccd2da; border-radius:8px; font-size:15px; background:white; min-width:180px; }
    .reference-input { min-width:220px; }
    .filter-button { border:none; border-radius:8px; padding:11px 18px; background:#1769e0; color:white; font-weight:bold; cursor:pointer; }
    .reset-button, .back-button { display:inline-block; border-radius:8px; padding:10px 17px; border:1px solid #ccd2da; color:#344054; background:white; text-decoration:none; font-weight:600; }
    .history-actions { display:flex; justify-content:space-between; align-items:center; gap:15px; margin-top:20px; flex-wrap:wrap; }
    .count { font-weight:bold; color:#667085; }
    .export-button { display:inline-block; border-radius:8px; padding:10px 17px; color:white; text-decoration:none; font-weight:700; margin-left:8px; background:#15803d; }
    .summary { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:24px; }
    .summary-card { background:white; border:1px solid #e1e5ec; border-radius:14px; padding:20px; box-shadow:0 2px 6px rgba(0,0,0,.04); }
    .summary-label { color:#667085; font-size:14px; font-weight:600; margin-bottom:7px; }
    .summary-value { font-size:27px; font-weight:800; color:#172033; }
    .summary-value.outstanding { color:#b45309; }
    .table-wrap { overflow-x:auto; }
    .history-table { width:100%; border-collapse:collapse; }
    .history-table th { text-align:left; background:#f2f4f7; color:#344054; padding:13px; border-bottom:1px solid #dfe3e8; white-space:nowrap; }
    .history-table td { padding:13px; border-bottom:1px solid #e1e5ec; vertical-align:middle; }
    .history-table tr:hover { background:#fafbfc; }
    .payment-reference { font-weight:700; color:#1769e0; }
    .status { display:inline-block; padding:5px 10px; border-radius:18px; font-weight:700; font-size:13px; background:#dcfce7; color:#15803d; }
    .view { color:#1769e0; font-weight:700; text-decoration:none; }
    .empty { text-align:center; color:#667085; padding:30px !important; }
    @media (max-width:900px) { .summary { grid-template-columns:1fr; } }
    @media (max-width:700px) {
        .history-page { padding:15px; }
        .history-header { flex-direction:column; }
        .filter { width:100%; }
    }
</style>

<%
    const totals = (typeof financeTotals !== 'undefined' && financeTotals)
        || { totalPayable:0, totalPaid:0, outstanding:0 };
    const filters = (typeof financeFilters !== 'undefined' && financeFilters) || {};
    const rows = (typeof paymentHistory !== 'undefined' && paymentHistory) || [];

    const filterParams = new URLSearchParams();
    Object.entries(filters).forEach(([key, value]) => {
        if (value) filterParams.set(key, value);
    });
    const query = filterParams.toString();
%>

<div class="history-page">
    <div class="history-header">
        <div>
            <h1>Payment History</h1>
            <div class="history-subtitle">Search, review and export completed official payments.</div>
        </div>
        <a href="/finance" class="back-button">Back to Finance</a>
    </div>

    <div class="summary">
        <div class="summary-card">
            <div class="summary-label">Total Payable</div>
            <div class="summary-value"><%= Number(totals.totalPayable || 0).toLocaleString() %> RWF</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Total Paid</div>
            <div class="summary-value"><%= Number(totals.totalPaid || 0).toLocaleString() %> RWF</div>
        </div>
        <div class="summary-card">
            <div class="summary-label">Outstanding Amount</div>
            <div class="summary-value outstanding"><%= Number(totals.outstanding || 0).toLocaleString() %> RWF</div>
        </div>
    </div>

    <div class="history-card">
        <div class="history-filters">
            <form method="GET" action="/finance/history">
                <div class="filter-row">
                    <select name="season" class="filter">
                        <option value="">All Seasons</option>
                        <% (seasons || []).forEach(item => { %>
                            <option value="<%= item.season %>" <%= filters.season === String(item.season) ? 'selected' : '' %>><%= item.season %></option>
                        <% }) %>
                    </select>

                    <select name="competition" class="filter">
                        <option value="">All Competitions</option>
                        <% (competitions || []).forEach(item => { %>
                            <option value="<%= item.competition %>" <%= filters.competition === String(item.competition) ? 'selected' : '' %>><%= item.competition %></option>
                        <% }) %>
                    </select>

                    <select name="official" class="filter">
                        <option value="">All Officials</option>
                        <% (officials || []).forEach(item => { %>
                            <option value="<%= item.fullname %>" <%= filters.official === String(item.fullname) ? 'selected' : '' %>><%= item.fullname %></option>
                        <% }) %>
                    </select>

                    <input name="fromDate" class="filter" type="date" value="<%= filters.fromDate || '' %>" title="From date">
                    <input name="toDate" class="filter" type="date" value="<%= filters.toDate || '' %>" title="To date">
                    <input name="reference" class="filter reference-input" type="search" placeholder="Payment reference" value="<%= filters.reference || '' %>">

                    <select name="status" class="filter">
                        <option value="">All Statuses</option>
                        <option value="PAID" <%= filters.status === 'PAID' ? 'selected' : '' %>>Paid</option>
                        <option value="PENDING" <%= filters.status === 'PENDING' ? 'selected' : '' %>>Pending</option>
                        <option value="PARTIAL" <%= filters.status === 'PARTIAL' ? 'selected' : '' %>>Partially Paid</option>
                    </select>

                    <button type="submit" class="filter-button">Search</button>
                    <a href="/finance/history" class="reset-button">Reset</a>
                </div>
            </form>

            <div class="history-actions">
                <span class="count"><%= rows.length %> payment record(s)</span>
                <div>
                    <a class="export-button" href="/finance/export/excel<%= query ? '?' + query : '' %>">Export Excel</a>
                    <a class="export-button" href="/finance/export/pdf<%= query ? '?' + query : '' %>">Export PDF</a>
                </div>
            </div>
        </div>
    </div>

    <div class="history-card">
        <h2 style="margin-top:0;">Payment History</h2>
        <div class="table-wrap">
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Payment Reference</th>
                        <th>Payment Date</th>
                        <th>Official(s)</th>
                        <th>Competition(s)</th>
                        <th>Season(s)</th>
                        <th>Games</th>
                        <th>Amount Paid</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (rows.length === 0) { %>
                        <tr><td colspan="10" class="empty">No payment records match the selected filters.</td></tr>
                    <% } else { %>
                        <% rows.forEach(payment => { %>
                            <tr>
                                <td class="payment-reference"><%= payment.payment_reference || '-' %></td>
                                <td><%= payment.paid_at ? new Date(payment.paid_at).toLocaleDateString('en-GB') : '-' %></td>
                                <td><%= payment.officials || '-' %></td>
                                <td><%= payment.competitions || '-' %></td>
                                <td><%= payment.seasons || '-' %></td>
                                <td><%= payment.game_count || 0 %></td>
                                <td><strong><%= Number(payment.total_amount || 0).toLocaleString() %> RWF</strong></td>
                                <td><%= payment.payment_method || '-' %></td>
                                <td><span class="status"><%= payment.payment_status || 'PAID' %></span></td>
                                <td><a class="view" href="/finance/payment-success/<%= payment.paymentid %>">View</a></td>
                            </tr>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
