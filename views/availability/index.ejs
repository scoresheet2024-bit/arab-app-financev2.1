<%- include('../partials/header', { title: title }) %>
<%- include('../partials/navigation') %>

<main class="arab-page availability-page">
    <div class="availability-container">

        <div class="availability-page-header">
            <div>
                <h1><%= title %></h1>
                <p>
                    <%= isAdmin
                        ? 'View and manage availability for all officials.'
                        : 'You are available by default. Add only the periods when you cannot officiate.' %>
                </p>
            </div>
        </div>

        <% if (success) { %>
            <div class="availability-alert availability-alert-success">
                <%= success %>
            </div>
        <% } %>

        <% if (isAdmin) { %>
            <section class="availability-card">
                <div class="availability-card-header">
                    <div>
                        <h2>Officials</h2>
                        <p>Select an official to view or manage availability.</p>
                    </div>
                </div>

                <div class="availability-official-grid">
                    <% officials.forEach(item => { %>
                        <a
                            class="availability-official-card <%= item.current_status === 'Not Available' ? 'is-unavailable' : 'is-available' %> <%= selectedOfficialId == item.officialid ? 'selected' : '' %>"
                            href="/my-availability?officialid=<%= item.officialid %>"
                        >
                            <div class="availability-official-name">
                                <%= item.fullname %>
                            </div>
                            <div class="availability-official-role">
                                <%= item.role || 'Official' %>
                            </div>
                            <div class="availability-status <%= item.current_status === 'Available' ? 'available' : 'unavailable' %>">
                                <span class="availability-status-dot"></span>
                                <%= item.current_status %>
                            </div>

                            <% if (item.current_status === 'Not Available' && item.active_start_date && item.active_end_date) { %>
                                <div class="availability-card-period">
                                    <span>Unavailable:</span>
                                    <strong>
                                        <%= new Date(item.active_start_date).toLocaleDateString() %>
                                        –
                                        <%= new Date(item.active_end_date).toLocaleDateString() %>
                                    </strong>
                                </div>
                            <% } %>
                        </a>
                    <% }) %>

                    <% if (officials.length === 0) { %>
                        <div class="availability-empty">
                            No officials were found.
                        </div>
                    <% } %>
                </div>
            </section>
        <% } %>

        <% if (official) { %>
            <section class="availability-card">
                <div class="availability-profile">
                    <div>
                        <h2><%= official.fullname %></h2>
                        <p><%= official.role || 'Official' %></p>
                    </div>

                    <div class="availability-current-status <%= currentStatus === 'Available' ? 'available' : 'unavailable' %>">
                        <span class="availability-status-dot"></span>
                        <strong><%= currentStatus %></strong>
                        <% if (currentStatus === 'Available') { %>
                            <small>Available by default</small>
                        <% } else if (activeRecord) { %>
                            <small>
                                <%= new Date(activeRecord.start_date).toLocaleDateString() %>
                                –
                                <%= new Date(activeRecord.end_date).toLocaleDateString() %>
                            </small>
                        <% } %>
                    </div>
                </div>
            </section>

            <section class="availability-card">
                <div class="availability-card-header">
                    <div>
                        <h2>Add Unavailability</h2>
                        <p>
                            Use this only for a period when the official cannot officiate.
                        </p>
                    </div>
                </div>

                <form action="/my-availability" method="POST" class="availability-form">
                    <% if (isAdmin) { %>
                        <input type="hidden" name="officialid" value="<%= official.officialid %>">
                    <% } %>

                    <div class="availability-form-grid">
                        <label>
                            <span>From</span>
                            <input
                                type="date"
                                name="start_date"
                                <%= !isAdmin ? `min="${today}"` : '' %>
                                required
                            >
                        </label>

                        <label>
                            <span>To</span>
                            <input
                                type="date"
                                name="end_date"
                                <%= !isAdmin ? `min="${today}"` : '' %>
                                required
                            >
                        </label>

                        <label class="availability-reason-field">
                            <span>Reason <em>(optional)</em></span>
                            <input
                                type="text"
                                name="reason"
                                maxlength="250"
                                placeholder="e.g. Travel, personal commitment"
                            >
                        </label>
                    </div>

                    <div class="availability-form-actions">
                        <button type="submit" class="availability-primary-button">
                            + Add Unavailability
                        </button>
                    </div>
                </form>
            </section>

            <section class="availability-card">
                <div class="availability-card-header">
                    <div>
                        <h2>Availability History</h2>
                        <p>Upcoming periods are shown first.</p>
                    </div>
                </div>

                <% if (availability.length > 0) { %>
                    <div class="availability-table-wrap">
                        <table class="availability-table">
                            <thead>
                                <tr>
                                    <th>From</th>
                                    <th>To</th>
                                    <th>Status</th>
                                    <th>Reason</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% availability.forEach(item => {
                                    const today = new Date().toISOString().slice(0, 10);
                                    const start = String(item.start_date).slice(0, 10);
                                    const end = String(item.end_date).slice(0, 10);
                                    const isActive = start <= today && today <= end;
                                    const isPast = end < today;
                                %>
                                    <tr>
                                        <td><%= new Date(item.start_date).toLocaleDateString() %></td>
                                        <td><%= new Date(item.end_date).toLocaleDateString() %></td>
                                        <td>
                                            <% if (isActive) { %>
                                                <span class="availability-badge unavailable">Not Available</span>
                                            <% } else if (isPast) { %>
                                                <span class="availability-badge past">Past</span>
                                            <% } else { %>
                                                <span class="availability-badge upcoming">Upcoming</span>
                                            <% } %>
                                        </td>
                                        <td><%= item.reason || '—' %></td>
                                        <td>
                                            <div class="availability-actions">
                                                <details class="availability-edit-details">
                                                    <summary>Edit</summary>
                                                    <form
                                                        action="/my-availability/edit/<%= item.availabilityid %>"
                                                        method="POST"
                                                        class="availability-edit-form"
                                                    >
                                                        <% if (isAdmin) { %>
                                                            <input type="hidden" name="officialid" value="<%= official.officialid %>">
                                                        <% } %>
                                                        <label>
                                                            From
                                                            <input
                                                                type="date"
                                                                name="start_date"
                                                                value="<%= String(item.start_date).slice(0, 10) %>"
                                                                <%= !isAdmin ? `min="${today}"` : '' %>
                                                                required
                                                            >
                                                        </label>
                                                        <label>
                                                            To
                                                            <input
                                                                type="date"
                                                                name="end_date"
                                                                value="<%= String(item.end_date).slice(0, 10) %>"
                                                                <%= !isAdmin ? `min="${today}"` : '' %>
                                                                required
                                                            >
                                                        </label>
                                                        <label>
                                                            Reason
                                                            <input
                                                                type="text"
                                                                name="reason"
                                                                maxlength="250"
                                                                value="<%= item.reason || '' %>"
                                                            >
                                                        </label>
                                                        <button type="submit" class="availability-save-button">
                                                            Save
                                                        </button>
                                                    </form>
                                                </details>

                                                <form
                                                    action="/my-availability/delete/<%= item.availabilityid %>"
                                                    method="POST"
                                                    onsubmit="return confirm('Delete this unavailability period?');"
                                                >
                                                    <button type="submit" class="availability-delete-button">
                                                        Delete
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="availability-empty">
                        No unavailability periods have been recorded.
                        <strong>This official is available by default.</strong>
                    </div>
                <% } %>
            </section>
        <% } %>

        <% if (!official && isAdmin) { %>
            <section class="availability-card availability-empty">
                Select an official above to view their availability.
            </section>
        <% } %>

    </div>
</main>

</body>
</html>
