<!DOCTYPE html>
<html>
<head>
    <title>Games - ARAB Reporting System</title>

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family:
                Arial,
                sans-serif;
            background: #f7f9fc;
            color: #172033;
        }

        .main {
            padding: 35px;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .page-title {
            margin: 0;
            font-size: 36px;
        }

        .subtitle {
            color: #667085;
            margin-top: 8px;
            font-size: 17px;
        }

        .create-button {
            background-color: #198754;
            color: white;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 7px;
            font-weight: bold;
        }

        .create-button:hover {
            background-color: #146c43;
        }

        .games-container {
            background: white;
            border: 1px solid #e1e5ec;
            border-radius: 14px;
            padding: 25px;
            box-shadow:
                0 2px 6px
                rgba(0,0,0,0.04);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;
            background: #f2f4f7;
            color: #344054;
            padding: 14px;
            border-bottom:
                1px solid #dfe3e8;
        }

        td {
            padding: 14px;
            border-bottom:
                1px solid #e1e5ec;
        }

        tr:hover {
            background: #fafbfc;
        }

        .assign-button {
            display: inline-block;
            background: #1769e0;
            color: white;
            padding: 8px 14px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
        }

        .assign-button:hover {
            background: #0d56c7;
        }

        .pending {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background: #fef3c7;
            color: #b45309;
            font-weight: bold;
        }

        .no-games {
            text-align: center;
            padding: 40px;
            color: #667085;
            font-size: 17px;
        }

        .back-button {
            display: inline-block;
            margin-top: 25px;
            background: #6c757d;
            color: white;
            padding: 10px 18px;
            text-decoration: none;
            border-radius: 6px;
        }

        .back-button:hover {
            background: #5c636a;
        }

        @media (max-width: 900px) {
            .main {
                padding: 20px;
            }

            .page-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 15px;
            }

            table {
                font-size: 14px;
            }

            th,
            td {
                padding: 9px;
            }
        }
    </style>
</head>

<body>

    <!-- REUSABLE NAVIGATION -->
    <%- include('../partials/navigation') %>

    <% const userRole = String((currentUser && (currentUser.actualRole || currentUser.role)) || '').trim().toLowerCase(); %>
    <% const canManageGames = ['admin', 'to', 'technical official', 'technical_official', 'technical-official'].includes(userRole); %>

    <!-- MAIN CONTENT -->
    <div class="main">

        <div class="page-header">

            <div>
                <h1 class="page-title">
                    Games
                </h1>

                <div class="subtitle">
                    Manage pending games and assign officials
                </div>
            </div>

            <% if (canManageGames) { %>
                <a
                    href="/games/new"
                    class="create-button"
                >
                    + Create Game
                </a>
            <% } %>

        </div>

        <div class="games-container">

            <% if (!games || games.length === 0) { %>

                <div class="no-games">
                    There are no pending games.
                </div>

            <% } else { %>

                <div style="overflow-x:auto;">
                    <table>

                        <thead>
                            <tr>
                                <th>
                                    Game ID
                                </th>

                                <th>
                                    Competition
                                </th>

                                <th>
                                    Team A
                                </th>

                                <th>
                                    Team B
                                </th>

                                <th>
                                    Date
                                </th>

                                <th>
                                    Time
                                </th>

                                <th>
                                    Court
                                </th>

                                <th>
                                    Status
                                </th>

                                <th>
                                    Action
                                </th>
                            </tr>
                        </thead>

                        <tbody>

                            <% games.forEach(game => { %>

                                <tr>

                                    <td>
                                        <strong>
                                            <%= game.gameid %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= game.competition || '-' %>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= game.teama %>
                                        </strong>
                                    </td>

                                    <td>
                                        <strong>
                                            <%= game.teamb %>
                                        </strong>
                                    </td>

                                    <td>
                                        <%= game.gamedate
                                            ? new Date(game.gamedate)
                                                .toLocaleDateString('en-GB')
                                            : '-'
                                        %>
                                    </td>

                                    <td>
                                        <%= game.gametime || '-' %>
                                    </td>

                                    <td>
                                        <%= game.court || '-' %>
                                    </td>

                                    <td>
                                        <span class="pending">
                                            Pending
                                        </span>
                                    </td>

                                    <td>
                                        <% if (canManageGames) { %>
                                            <a
                                                href="/games/assign/<%= game.gameid %>"
                                                class="assign-button"
                                            >
                                                Assign
                                            </a>
                                        <% } else { %>
                                            <span style="color:#98a2b3;">View only</span>
                                        <% } %>
                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>
                </div>

            <% } %>

        </div>

        <a
            href="/"
            class="back-button"
        >
            ← Back to Dashboard
        </a>

    </div>

<%- include('../partials/footer') %>

</body>
</html>