<%- include('../partials/header', {
    title: 'Officials'
}) %>


<%- include('../partials/navigation') %>


<div class="arab-page">


    <!-- ==================================================
         PAGE HEADER
    ================================================== -->

    <div
        style="
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        "
    >

        <div>

            <h1 class="page-title">
                Officials
            </h1>

            <div class="subtitle">
                Manage basketball officials
            </div>

        </div>


        <a
            href="/officials/new"
            class="button button-success"
        >
            + Add New Official
        </a>

    </div>


    <!-- ==================================================
         SEARCH
    ================================================== -->

    <input
        type="text"
        id="searchOfficials"
        placeholder="Search official by name..."
        autocomplete="off"
        style="
            width: 350px;
            max-width: 100%;
            padding: 12px;
            font-size: 16px;
            border: 1px solid #ced4da;
            border-radius: 6px;
            margin-bottom: 20px;
        "
    >


    <!-- ==================================================
         OFFICIALS TABLE
    ================================================== -->

    <div
        style="
            background: white;
            border-radius: 12px;
            overflow-x: auto;
            border: 1px solid #e1e5ec;
        "
    >

        <table>

            <thead>

                <tr>

                    <th>
                        ID
                    </th>

                    <th>
                        Full Name
                    </th>

                    <th>
                        Role
                    </th>

                    <th>
                        Phone
                    </th>

                    <th>
                        Email
                    </th>

                    <th>
                        Actions
                    </th>

                </tr>

            </thead>


            <tbody id="officialTable">


                <% if (!officials || officials.length === 0) { %>

                    <tr>

                        <td
                            colspan="6"
                            style="
                                text-align: center;
                                padding: 30px;
                                color: #667085;
                            "
                        >
                            No officials found.
                        </td>

                    </tr>


                <% } else { %>


                    <% officials.forEach(function(official) { %>

                        <tr>

                            <td>
                                <%= official.officialid %>
                            </td>


                            <td>
                                <%= official.fullname || '' %>
                            </td>


                            <td>
                                <%= official.role || '' %>
                            </td>


                            <td>
                                <%= official.phone || '' %>
                            </td>


                            <td>
                                <%= official.email || '' %>
                            </td>


                            <td>

                                <a
                                    href="/officials/edit/<%= official.officialid %>"
                                    class="button button-primary"
                                    style="
                                        margin-right: 5px;
                                    "
                                >
                                    Edit
                                </a>


                                <form
                                    action="/officials/delete/<%= official.officialid %>"
                                    method="POST"
                                    style="
                                        display: inline;
                                    "
                                    onsubmit="
                                        return confirm(
                                            'Are you sure you want to delete this official?'
                                        );
                                    "
                                >

                                    <button
                                        type="submit"
                                        class="button button-danger"
                                    >
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>


                    <% }); %>


                <% } %>


            </tbody>

        </table>

    </div>


</div>


<script>

    // ==================================================
    // SEARCH OFFICIALS
    // ==================================================

    const searchBox =
        document.getElementById(
            'searchOfficials'
        );


    const table =
        document.getElementById(
            'officialTable'
        );


    if (searchBox && table) {

        searchBox.addEventListener(
            'input',
            function() {

                const search =
                    this.value
                        .toLowerCase()
                        .trim();


                const rows =
                    table.querySelectorAll(
                        'tr'
                    );


                rows.forEach(function(row) {

                    // Ignore rows without
                    // the expected cells.

                    if (
                        row.children.length < 2
                    ) {

                        return;

                    }


                    const name =
                        row.children[1]
                            .textContent
                            .toLowerCase();


                    if (
                        name.includes(search)
                    ) {

                        row.style.display =
                            '';

                    } else {

                        row.style.display =
                            'none';

                    }

                });

            }
        );

    }

</script>


<%- include('../partials/footer') %>