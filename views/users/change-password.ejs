<%- include('../partials/header', { title: 'Update Password' }) %>
<%- include('../partials/navigation') %>

<main class="password-page">
  <div class="password-header">
    <div class="password-eyebrow">ACCOUNT SETTINGS</div>
    <h1>Update Password</h1>
    <p>Change your account password securely.</p>
  </div>

  <% if (error) { %>
    <div class="password-alert"><%= error %></div>
  <% } %>

  <section class="password-card">
    <div class="password-card-title">
      <div class="password-icon">🔐</div>
      <div>
        <h2>Change Password</h2>
        <p>Enter your current password and choose a new password.</p>
      </div>
    </div>

    <form method="POST" action="/account/password" class="password-form" autocomplete="off">
      <div class="password-field">
        <label for="currentPassword">Current Password</label>
        <div class="password-input-wrap">
          <input id="currentPassword" type="password" name="currentPassword" required autocomplete="current-password">
          <button type="button" class="password-toggle" data-target="currentPassword">👁</button>
        </div>
      </div>

      <div class="password-field">
        <label for="newPassword">New Password</label>
        <div class="password-input-wrap">
          <input id="newPassword" type="password" name="newPassword" required minlength="8" autocomplete="new-password">
          <button type="button" class="password-toggle" data-target="newPassword">👁</button>
        </div>
        <div class="password-requirements">
          <strong>Password requirement</strong>
          <span id="lengthRequirement">✓ At least 8 characters</span>
        </div>
      </div>

      <div class="password-field">
        <label for="confirmPassword">Confirm New Password</label>
        <div class="password-input-wrap">
          <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password">
          <button type="button" class="password-toggle" data-target="confirmPassword">👁</button>
        </div>
      </div>

      <div class="password-actions">
        <a href="/" class="password-cancel">Cancel</a>
        <button type="submit" class="password-submit">Update Password</button>
      </div>
    </form>
  </section>
</main>

<style>
.password-page{max-width:900px;margin:0 auto;padding:34px 36px 50px;background:#f7f9fc;min-height:calc(100vh - 68px);box-sizing:border-box;color:#172033}
.password-header{margin-bottom:24px}.password-eyebrow{font-size:12px;font-weight:800;letter-spacing:.12em;color:#6b7a90;margin-bottom:7px}.password-header h1{margin:0 0 7px;color:#102a56;font-size:36px}.password-header p{margin:0;color:#667085;font-size:17px}
.password-alert{margin-bottom:18px;padding:13px 16px;border-radius:10px;background:#fff1f2;border:1px solid #fecdd3;color:#b42318}
.password-card{max-width:680px;background:#fff;border:1px solid #dbe4ef;border-radius:16px;padding:30px;box-shadow:0 4px 16px rgba(16,42,86,.06)}
.password-card-title{display:flex;align-items:center;gap:14px;padding-bottom:22px;margin-bottom:22px;border-bottom:1px solid #e8edf3}.password-icon{width:48px;height:48px;display:grid;place-items:center;border-radius:12px;background:#eef5ff;font-size:23px}.password-card-title h2{margin:0 0 4px;color:#102a56;font-size:22px}.password-card-title p{margin:0;color:#718096;font-size:14px}
.password-field{margin-bottom:20px}.password-field label{display:block;margin-bottom:8px;font-weight:700;color:#24364b}.password-input-wrap{position:relative}.password-input-wrap input{width:100%;box-sizing:border-box;padding:13px 48px 13px 14px;border:1px solid #cfd9e6;border-radius:9px;font-size:16px;outline:none}.password-input-wrap input:focus{border-color:#1769aa;box-shadow:0 0 0 3px rgba(23,105,170,.12)}.password-toggle{position:absolute;right:7px;top:50%;transform:translateY(-50%);border:0;background:transparent;cursor:pointer;padding:8px}
.password-requirements{margin-top:8px;padding:10px 12px;background:#f7f9fc;border-radius:8px;color:#68778b;display:flex;flex-direction:column;gap:3px;font-size:13px}.password-actions{display:flex;justify-content:flex-end;align-items:center;gap:12px;margin-top:28px}.password-cancel{text-decoration:none;padding:11px 18px;border:1px solid #cbd5e1;border-radius:9px;color:#334155;font-weight:700}.password-submit{border:0;padding:12px 20px;border-radius:9px;background:#1268ad;color:#fff;font-weight:800;cursor:pointer}.password-submit:hover{background:#0d578f}
@media(max-width:700px){.password-page{padding:24px 16px 40px}.password-header h1{font-size:30px}.password-card{padding:22px}.password-actions{flex-direction:column-reverse;align-items:stretch}.password-cancel,.password-submit{text-align:center}}
</style>

<script>
document.querySelectorAll('.password-toggle').forEach(function(button){button.addEventListener('click',function(){const input=document.getElementById(button.dataset.target);if(!input)return;input.type=input.type==='password'?'text':'password';button.textContent=input.type==='password'?'👁':'🙈';});});
const np=document.getElementById('newPassword'),lr=document.getElementById('lengthRequirement');if(np&&lr){np.addEventListener('input',function(){lr.style.color=np.value.length>=8?'#16834b':'#68778b';});}
</script>
